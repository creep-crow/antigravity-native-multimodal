{
  "native-multimodal-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 hooks/multimodal_guard.py || python -X utf8 hooks/multimodal_guard.py",
            "timeout": 25
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 hooks/multimodal_guard.py || python -X utf8 hooks/multimodal_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
